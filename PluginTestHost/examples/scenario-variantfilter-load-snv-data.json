{
  "name": "VariantFilter: POST /loadSnvData against the live MolgenDB database",
  "executor": "process",
  "timeouts": {
    "call_ms": 60000,
    "unload_ms": 20000,
    "lifecycle_ms": 10000
  },
  "principal": {
    "user_id": "plugin-testhost-variantfilter",
    "username": "variantfilter-test",
    "given_name": "VariantFilter",
    "family_name": "IntegrationTest",
    "groups": [
      "plugin-test",
      "variantfilter-testers"
    ],
    "session_id": "variantfilter-live-db-session"
  },
  "database": {
    "mode": "live"
  },
  "tests": [
    {
      "name": "POST /loadSnvData loads SNV data from MolgenDB",
      "request": {
        "endpoint_id": "load-snv-data",
        "method": "POST",
        "path": "/loadSnvData",
        "content_type": "application/json",
        "body": {
          "patient_ids": [
            "00000000-0000-0000-0000-000000000001"
          ]
        }
      },
      "expect": {
        "status": 200,
        "body_json_path_equals": {
          "path": "status",
          "equals": "loaded"
        },
        "database_call_count": 1
      }
    },
    {
      "name": "POST /filterSnvData creates the filtered result for the loaded patient",
      "request": {
        "endpoint_id": "filter-snv-data",
        "method": "POST",
        "path": "/filterSnvData",
        "content_type": "application/json",
        "body": {
          "index_uuid": "00000000-0000-0000-0000-000000000001",
          "simple_filter_parameter": {
            "is_cnv_change_filter": false,
            "min_cnv_gain": null,
            "min_cnv_loss": null,
            "is_panel_filter": false,
            "panel_gene_set": [],
            "is_lookup_filter": false,
            "lookup_gene_set": [],
            "is_read_depth_filter": false,
            "min_read_depth": null,
            "is_gnomad_filter": false,
            "max_frequency": null,
            "is_impact_filter": false,
            "impact_set": []
          },
          "complex_filter_parameter": {
            "paternal_uuid": null,
            "maternal_uuid": null,
            "mode_of_inheritance": "DOM",
            "check_for_denovo": false,
            "paternal_disease_known": false,
            "maternal_disease_known": false,
            "stringent": false,
            "include_cnvs": false
          },
          "custom_filters": []
        }
      },
      "expect": {
        "status": 200,
        "database_call_count": 0
      }
    },
    {
      "name": "GET /getSnvTable returns a page of the filtered data for the same session",
      "request": {
        "endpoint_id": "get-snv-table",
        "method": "GET",
        "path": "/getSnvTable"
      },
      "expect": {
        "status": 200,
        "database_call_count": 0
      }
    },
    {
      "name": "close test session and clear VariantFilter cache",
      "session_closed": true,
      "session_id": "variantfilter-live-db-session",
      "expect": {
        "session_close_success": true
      }
    }
  ],
  "expect_unload_success": true
}
